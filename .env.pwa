# Mode « pwa » : test de l'application installable avec le serveur de mocks Node (M6 §3.2).
# Utilisé par `npm run preview:pwa` (build + preview) et `npm run mock:api` (serveur 8787).
# 127.0.0.1 et non localhost : les gestionnaires MSW comparent l'origine exacte.
VITE_API_MOCK=false
VITE_API_BASE_URL=http://127.0.0.1:8787/api
VITE_PWA_ENABLED=true
VITE_ENABLE_DEV_PAGE=true
