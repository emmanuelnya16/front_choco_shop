# Mode « e2e » : parcours de bout en bout Playwright (M7 §8), lancés par `npm run e2e`.
# Même principe que .env.pwa : build de prévisualisation (port 4174) + serveur de mocks Node (port 8787).
# 127.0.0.1 et non localhost : les gestionnaires MSW du serveur de mocks comparent l'origine exacte.
VITE_API_MOCK=false
VITE_API_BASE_URL=http://127.0.0.1:8787/api
# Service worker actif : nécessaire au parcours hors connexion (n° 8)
VITE_PWA_ENABLED=true
# Simulateur boutique sur /_dev (parcours 3, 4 et 5)
VITE_ENABLE_DEV_PAGE=true
